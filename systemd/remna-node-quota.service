[Unit]
Description=Remnawave per-node quota limiter
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/remna-node-quota
Environment=PYTHONPATH=/opt/remna-node-quota
ExecStartPre=/opt/remna-node-quota/venv/bin/python -m remna_node_quota -c /etc/remna-node-quota/config.json --prepare-container
ExecStart=/opt/remna-node-quota/venv/bin/python -m remna_node_quota -c /etc/remna-node-quota/config.json
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
